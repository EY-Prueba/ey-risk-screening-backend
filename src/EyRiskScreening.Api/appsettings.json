{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "EyRiskScreening.Api",
    "Audience": "EyRiskScreening.Clients",
    "ExpirationMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "BootstrapAdmin": {
    "Enabled": false
  },
  "OpenApi": {
    "Enabled": false
  },
  "Screening": {
    "GlobalTimeoutSeconds": 40,
    "Sources": {
      "OffshoreLeaks": {
        "MatchThreshold": 80,
        "TimeoutSeconds": 20,
        "ResultLimit": 100
      },
      "WorldBank": {
        "MatchThreshold": 80,
        "TimeoutSeconds": 30,
        "ResultLimit": 100
      },
      "Ofac": {
        "MatchThreshold": 80,
        "TimeoutSeconds": 35,
        "ResultLimit": 100
      }
    }
  },
  "OfacAdapter": {
    "BaseUrl": "https://sanctionslistservice.ofac.treas.gov",
    "SnapshotTtlMinutes": 60,
    "MaxResponseBytes": 67108864,
    "MaxCandidates": 50000,
    "MaxNamesPerCandidate": 100,
    "IncludeWeakAliases": false,
    "UserAgent": "EY-Risk-Screening/1.0"
  },
  "WorldBankAdapter": {
    "BaseUrl": "https://projects.worldbank.org/en/projects-operations/procurement/debarred-firms",
    "SnapshotTtlMinutes": 180,
    "MaxRows": 10000,
    "MaxRequestsPerRefresh": 64,
    "MaxRenderedContentBytes": 8388608,
    "CleanupTimeoutSeconds": 5,
    "BrowserHeadless": true,
    "TableSelector": "#k-debarred-firms",
    "RowSelector": "#k-debarred-firms .k-grid-content tbody tr",
    "UserAgent": "EY-Risk-Screening/1.0"
  },
  "OffshoreLeaksAdapter": {
    "BaseUrl": "https://offshoreleaks.icij.org",
    "QueryCacheTtlMinutes": 30,
    "QueryCacheMaxEntries": 500,
    "EntityCacheTtlHours": 6,
    "EntityCacheMaxEntries": 5000,
    "MaxCandidatesPerNamespace": 25,
    "MaxCandidatesBeforeDeduplication": 125,
    "MaxExtensionIds": 25,
    "MaxConcurrentRequests": 2,
    "MaxRequestsPerQuery": 10,
    "MaxQueryResponseBytes": 524288,
    "MaxExtensionResponseBytes": 1048576,
    "MaxJsonDepth": 16,
    "UserAgent": "EY-Risk-Screening/1.0"
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Screening": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "AllowedHosts": "*"
}
