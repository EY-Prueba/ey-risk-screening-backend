{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "EyRiskScreening.Api",
    "Audience": "EyRiskScreening.Clients",
    "ExpirationMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "BootstrapAdmin": {
    "Enabled": false
  },
  "Screening": {
    "GlobalTimeoutSeconds": 40,
    "Sources": {
      "OffshoreLeaks": {
        "MatchThreshold": 80,
        "TimeoutSeconds": 20,
        "ResultLimit": 100
      },
      "WorldBank": {
        "MatchThreshold": 80,
        "TimeoutSeconds": 35,
        "ResultLimit": 100
      },
      "Ofac": {
        "MatchThreshold": 80,
        "TimeoutSeconds": 35,
        "ResultLimit": 100
      }
    }
  },
  "OfacAdapter": {
    "BaseUrl": "https://sanctionslistservice.ofac.treas.gov",
    "SnapshotTtlMinutes": 60,
    "MaxResponseBytes": 67108864,
    "MaxCandidates": 50000,
    "MaxNamesPerCandidate": 100,
    "IncludeWeakAliases": false,
    "UserAgent": "EY-Risk-Screening/1.0"
  },
  "RateLimiting": {
    "Screening": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "AllowedHosts": "*"
}
